# ===========================================================================
# mako — notification daemon
#
# Why mako: without a notification daemon owning the D-Bus name
# org.freedesktop.Notifications, Firefox and Thunderbird draw each
# notification as an ordinary window, which Hyprland then tiles. mako draws on
# a layer surface instead, above the tiling layout.
#
# Palette is lifted from ~/.config/waybar/style.css so the two agree. Colours
# there are GTK rgba(); here they are #rrggbbaa. The mapping is
# rgba(30,35,50,0.46) -> #1E2332 with alpha round(0.46*255)=0x75.
#
# The compositor-side half of the glass is a layer_rule on the "notifications" namespace
# (what mako names its layer surface; `hyprctl layers` shows it)
# in ~/.config/hypr/lua/rules.lua -- same arrangement as the waybar and wofi rules. Without it
# these are flat translucent panels, not frosted ones.
# ===========================================================================

# IBM Plex Sans, like the bar and its panels (waybar/style.css explains why).
font=IBM Plex Sans SemiBold 11

# --- PALETTE ----------------------------------------------------------------
# Every colour mako uses is on one of these lines or in the [grouped] /
# [urgency=...] sections in ~/.config/mako/sections (the title colour lives
# inside format=).
#
# Deliberately more opaque than the bar's 0x75. The bar only ever sits over the
# top 36px of the screen and can afford to be see-through; a notification lands
# over whatever happens to be running, including white web pages, and has to
# stay readable there. 0xE8 is about 0.91 alpha -- still visibly glass once the
# compositor blur is on, but no longer transparent enough to read text through.
background-color=#060810E8
text-color=#E6FCFF
border-color=#00F0FFB3
progress-color=over #00F0FF59

border-size=2
border-radius=4
padding=14
width=420
height=180

# Gap between stacked notifications.
margin=10

# Gap around the whole stack. The 44 clears the 36px waybar plus a little
# air; drop it to 10 if you ever move the bar off the top or hide it.
outer-margin=44,14,14,14

anchor=top-right
layer=overlay
max-visible=5

# No output= line: notifications follow the focused monitor (mako's
# default), so they land wherever you are already looking.

default-timeout=5000
ignore-timeout=0

# Keep dismissed notifications retrievable with `makoctl restore`.
history=1
max-history=50

# Stack repeats from the same app into one entry instead of a tower of five
# identical Discord pings. The [grouped] block below is what that collapsed
# entry looks like.
group-by=app-name

format=<span color="#00F0FF"><b>%s</b></span>\n%b
markup=1
actions=1

icons=1
max-icon-size=48
icon-location=left

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all

# ---------------------------------------------------------------------------
# Criteria sections ([grouped], [urgency=critical], [urgency=low], do not
# disturb) live in ~/.config/mako/sections, included here as the LAST line.
#
# Why a second file: mako refuses include= inside a [section], and once a
# section header appears every line after it belongs to that section. An
# included file starts in the global scope and may open sections of its own.
# ---------------------------------------------------------------------------
include=~/.config/mako/sections
