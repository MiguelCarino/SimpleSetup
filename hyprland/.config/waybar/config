// Waybar -- Carino Hyprland bar. One bar on every screen, built-in modules
// only, so nothing here depends on a script outside this bundle (the power
// pill's menu is ~/.config/hypr/scripts/power-menu.sh). Looks: style.css.
[
{
    // The name is also the layer namespace "waybar-main", which the
    // waybar-glass layer rule in ~/.config/hypr/lua/rules.lua frosts.
    "name": "waybar-main",
    "layer": "top",
    "position": "top",
    "margin": "0 0 0 0",
    "reload_style_on_change": true,

    "modules-left": [
        "ext/workspaces",
        "hyprland/submap",
        "hyprland/language",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],

    // ext/workspaces, not hyprland/workspaces: hyprland/workspaces sends
    // hyprlang strings such as "dispatch workspace 4", which a Lua config
    // rejects, so every click would silently do nothing. ext/workspaces uses
    // the ext-workspace-v1 Wayland protocol instead. It only shows workspaces
    // that exist, which is why 1-6 are persistent in lua/rules.lua.
    // {name} rather than {id}: under this protocol {id} is an internal handle.
    "ext/workspaces": {
        "format": "{name}",
        "tooltip": false,
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-name": true
    },

    // Shows "resize" while SUPER+R's resize mode is on.
    "hyprland/submap": {
        "format": " {}",
        "tooltip": false
    },

    // The active keyboard layout; SUPER+Space switches when there are two.
    "hyprland/language": {
        "format": "{short} ",
        "min-length": 5,
        "tooltip": false
    },

    "hyprland/window": {
        "tooltip": false,
        "format": "{title}",
        "separate-outputs": true,
        "max-length": 90,
        "icon": true,
        "icon-size": 16,
        "rewrite": {
            "(.*) — Mozilla Firefox": "  $1",
            "^$": "Desktop"
        }
    },

    // Left click: the month calendar in the tooltip. Scroll: change month.
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "interval": 5,
        "format": "{usage}% ",
        "tooltip": true,
        "on-click": "kitty -e htop"
    },

    "memory": {
        "interval": 10,
        "format": "{percentage}% ",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used",
        "on-click": "kitty -e htop"
    },

    // Left click opens the text-mode NetworkManager editor.
    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "",
        "format-disconnected": "offline ",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    // Left: the mixer. Right / middle: mute the output / the mic.
    "pulseaudio": {
        "reverse-scrolling": 1,
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": " {volume}% {icon} {format_source}",
        "format-bluetooth-muted": "  {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip": false,
        "min-length": 13
    },

    // Hidden on machines without a battery.
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "tooltip": false,
        "exec": "echo '{\"text\": \"\", \"tooltip\": \"Power menu  (Super+Esc)\"}'",
        "return-type": "json",
        "interval": "once",
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/power-menu.sh"
    }
}
]
